# Copy to .env and fill in.
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible endpoint (e.g. a provider supplied by the reviewers).
OPENAI_BASE_URL=

# The planner is the only LLM call; everything after it is deterministic.
PLANNER_MODEL=gpt-5.4

# ClinicalTrials.gov ingestion limits
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTGOV_MAX_RECORDS=3000
CTGOV_MAX_CONCURRENCY=8
CTGOV_TIMEOUT_S=20

# Citations
MAX_CITATIONS_PER_DATUM=5
